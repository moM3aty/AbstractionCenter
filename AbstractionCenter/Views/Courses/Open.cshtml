@using Microsoft.AspNetCore.Localization
@model IEnumerable<AbstractionCenter.Models.Entities.Course>
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    bool isRtl = requestCulture?.RequestCulture.UICulture.Name == "ar" || requestCulture?.RequestCulture.UICulture.Name == null;
    ViewData["Title"] = isRtl ? "دليل البرامج التدريبية" : "Course Catalog";
}

<style>
    /* --- المتغيرات والتنسيق الأساسي --- */
    :root {
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-dark: #0f172a;
        --text-gray: #64748b;
        --accent-gold: #d4af37;
        --accent-dark: #1e293b;
    }

    body {
        background-color: var(--bg-color);
    }

    .catalog-section {
        padding: 120px 0 100px;
    }

    /* --- الترويسة (Hero) --- */
    .catalog-hero {
        text-align: center;
        margin-bottom: 60px;
    }

        .catalog-hero h1 {
            font-size: 3rem;
            font-weight: 900;
            color: var(--text-dark);
            margin-bottom: 15px;
        }

            .catalog-hero h1 span {
                color: var(--accent-gold);
            }

        .catalog-hero p {
            font-size: 1.15rem;
            color: var(--text-gray);
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.8;
        }

    /* --- شبكة الكروت (Grid) --- */
    .modern-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 30px;
        padding: 0 15px;
    }

    /* --- الكارت الحديث (Modern Card) --- */
    .course-card {
        background: var(--card-bg);
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        border: 1px solid #f1f5f9;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
    }

        .course-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px -5px rgba(0,0,0,0.1);
            border-color: rgba(212, 175, 55, 0.3);
        }

    /* صورة الكارت والحالة */
    .card-img-box {
        position: relative;
        height: 220px;
        width: 100%;
        background: var(--accent-dark);
    }

        .card-img-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .status-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

        .status-badge.open {
            background: #10b981;
            color: white;
        }

        .status-badge.progress {
            background: #3b82f6;
            color: white;
        }

    /* تفاصيل الكارت */
    .card-content {
        padding: 25px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .course-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .course-note {
        font-size: 0.9rem;
        color: #b45309;
        background: #fffbeb;
        padding: 8px 12px;
        border-radius: 8px;
        margin-bottom: 15px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .course-desc {
        font-size: 0.95rem;
        color: var(--text-gray);
        line-height: 1.6;
        margin-bottom: 20px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    /* البيانات الوصفية */
    .card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

    .meta-data {
        font-size: 0.85rem;
        color: var(--text-gray);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .meta-data i {
            color: var(--accent-gold);
        }

    /* التسعير والزر */
    .card-footer {
        border-top: 1px solid #f1f5f9;
        padding-top: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .price-box {
        display: flex;
        flex-direction: column;
    }

    .price-final {
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--text-dark);
        line-height: 1;
    }

    .price-original {
        font-size: 0.9rem;
        text-decoration: line-through;
        color: #94a3b8;
        font-weight: 600;
        margin-top: 4px;
    }

    .discount-label {
        background: #ef4444;
        color: white;
        font-size: 0.7rem;
        padding: 2px 6px;
        border-radius: 4px;
        margin-right: 5px;
        font-weight: bold;
    }

    .btn-register {
        background: var(--text-dark);
        color: var(--accent-gold);
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 1rem;
        text-decoration: none;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-register:hover {
            background: var(--accent-gold);
            color: var(--text-dark);
        }

    /* --- Custom Select for Batches --- */
    .batch-select {
        width: 100%;
        padding: 12px 15px;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        background: #f8fafc;
        font-family: inherit;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 15px;
        outline: none;
        transition: 0.3s;
        cursor: pointer;
    }

        .batch-select:focus {
            border-color: var(--accent-gold);
            background: white;
        }

    /* === للموبايل فقط === */
    @@media (max-width: 768px) {
        .catalog-section

    {
        padding: 100px 0 60px;
    }

    .catalog-hero h1 {
        font-size: 2.2rem;
    }

    .catalog-hero p {
        font-size: 1rem;
        padding: 0 15px;
    }

    .modern-grid {
        grid-template-columns: 1fr;
        padding: 0 20px;
    }

    .card-img-box {
        height: 200px;
    }

    .card-content {
        padding: 20px;
    }

    }
</style>

<div class="catalog-section">
    <div class="container">

        <!-- الترويسة -->
        <div class="catalog-hero">
            <h1>@(isRtl ? "دليل البرامج" : "Learning") <span>@(isRtl ? "والدبلومات" : "Catalog")</span></h1>
            <p>@(isRtl ? "استثمر في مستقبلك وانضم إلى أقوى المسارات التدريبية المصممة لربطك بسوق العمل مباشرة، بقيادة نخبة من الخبراء." : "Invest in your future and join our powerful training tracks designed to connect you directly to the job market.")</p>
        </div>

        <!-- شبكة الكورسات -->
        <div class="modern-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var course in Model)
                {
                    // جلب الدفعات المتاحة لهذا الكورس فقط
                    var activeBatches = course.Batches
                    .Where(b => b.Status == AbstractionCenter.Models.Entities.BatchStatus.OpenForRegistration || b.Status == AbstractionCenter.Models.Entities.BatchStatus.InProgress)
                    .OrderBy(b => b.StartDate)
                    .ToList();

                    <div class="course-card">
                        <div class="card-img-box">
                            <div class="status-badge open"><i class="fa-solid fa-door-open"></i> @(isRtl ? "متاح للتسجيل" : "Open")</div>

                            @if (!string.IsNullOrEmpty(course.ImageUrl))
                            {
                                <img src="@course.ImageUrl" alt="@course.Title" loading="lazy" />
                            }
                            else
                            {
                                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-layer-group" style="font-size:4rem; color:rgba(255,255,255,0.2);"></i>
                                </div>
                            }
                        </div>

                        <div class="card-content">
                            <h2 class="course-title">@course.Title</h2>

                            <p class="course-desc">@course.Description</p>

                            <div class="card-footer" style="flex-direction: column; align-items: stretch; border-top: none; padding-top: 0; margin-top: auto;">
                                <form action="/Courses/Register" method="get" style="display: flex; flex-direction: column; gap: 10px; width: 100%;">
                                    <label style="font-size: 0.9rem; font-weight: 800; color: var(--text-gray);">@(isRtl ? "اختر الدفعة المناسبة:" : "Select Batch:")</label>

                                    <select name="id" class="batch-select" required>
                                        <option value="">-- @(isRtl ? "اضغط لاختيار الدفعة" : "Select a batch") --</option>
                                        @foreach (var b in activeBatches)
                                        {
                                            string statusText = b.Status == AbstractionCenter.Models.Entities.BatchStatus.OpenForRegistration ? (isRtl ? "مفتوحة" : "Open") : (isRtl ? "قيد التنفيذ" : "In Progress");

                                            // حساب السعر النهائي للدفعة داخل القائمة
                                            decimal finalPrice = b.Price;
                                            string priceText = "";
                                            if (b.ShowPrice)
                                            {
                                                if (b.ShowDiscount && b.DiscountPercentage > 0)
                                                {
                                                    finalPrice = b.Price * (decimal)(1 - (b.DiscountPercentage / 100.0));
                                                    priceText = $" - {finalPrice.ToString("0.##")}$ (خصم {b.DiscountPercentage}%)";
                                                }
                                                else
                                                {
                                                    priceText = $" - {finalPrice.ToString("0.##")}$";
                                                }
                                            }

                                            <option value="@b.Id">@b.BatchName (@statusText) @priceText</option>
                                        }
                                    </select>

                                    <button type="submit" class="btn-register" style="width: 100%; justify-content: center;">
                                        @(isRtl ? "المتابعة للتسجيل" : "Continue to Enroll") <i class="fa-solid @(isRtl ? "fa-arrow-left" : "fa-arrow-right")"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: white; border-radius: 20px; border: 2px dashed #cbd5e1;">
                    <i class="fa-solid fa-box-open" style="font-size: 4rem; color: #cbd5e1; margin-bottom: 20px;"></i>
                    <h3 style="color: var(--text-dark); font-weight: 800; font-size: 1.5rem; margin-bottom: 10px;">@(isRtl ? "لا توجد برامج متاحة حالياً" : "No Programs Available")</h3>
                    <p style="color: var(--text-gray); font-size: 1rem;">@(isRtl ? "يتم تحديث البرامج والدفعات بشكل مستمر، يرجى العودة لاحقاً." : "Programs are updated constantly, please check back later.")</p>
                </div>
            }
        </div>
    </div>
</div>